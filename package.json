    "./vue/text-area": {
      "types": "./dist/types/vue/text-area.d.ts",
      "import": "./dist/vue-text-area.js"
    },
    "./package.json": "./package.json",
    "./badge": {
      "types": "./dist/types/badge.d.ts",
      "import": "./dist/badge.js"
