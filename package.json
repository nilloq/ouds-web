  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp build && vp build --config vite.vue.config.ts && vue-tsc --declaration --emitDeclarationOnly --noEmit false --outDir dist/types",
    "dev": "vp build --watch",
    "playground": "vp run build && vp dev --config playground/vite.config.ts",
    "test": "vp test",
    "check": "vp check && vue-tsc --noEmit",
    "prepublishOnly": "vp run build",
    "prepare": "vp config && vp run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vueuse/core": "^15.1.0",
    "bumpp": "^12.3.0",
    "marked": "^18.3.0",
    "shiki": "^4.6.0",
    "shiki-transformer-copy-button": "^0.0.6",
    "typescript": "^5.9.3",
    "vite-plus": "catalog:",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "warn"
    }
  }
