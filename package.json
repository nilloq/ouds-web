      "import": "./dist/elements-checkbox.js"
    },
    "./components/radio": {
      "types": "./dist/types/elements/radio.d.ts",
      "import": "./dist/elements-radio.js"
    },
    "./components/switch": {
      "types": "./dist/types/elements/switch.d.ts",
      "import": "./dist/elements-switch.js"
