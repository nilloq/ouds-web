    },
    "./vue/checkbox": {
      "types": "./dist/types/vue/checkbox.d.ts",
      "import": "./dist/vue-checkbox.js"
    },
    "./vue/radio": {
      "types": "./dist/types/vue/radio.d.ts",
      "import": "./dist/vue-radio.js"
